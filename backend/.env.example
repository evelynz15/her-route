PORT=3000

# Comma-separated list of frontend origins allowed by CORS. Setting this replaces the default.
# FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Number of reverse-proxy hops in front of the app (e.g. 1 behind a load balancer).
# Leave empty when the app is exposed directly.
TRUST_PROXY=
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Photon geocoding, defaults to the public https://photon.komoot.io instance. 
# Set PHOTON_URL to self-host.
PHOTON_URL=
PHOTON_USER_AGENT=

# OSRM routing (free FOSSGIS server for dev; self-host for production)
OSRM_URL=https://routing.openstreetmap.de/routed-foot

# Overpass (OpenStreetMap data for the seed script). Both optional.
# A custom User-Agent is required: Overpass returns 406 for Node's default one.
OVERPASS_URL=
OVERPASS_USER_AGENT=
